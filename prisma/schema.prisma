// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User model
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //Relations
  watchListItems WatchlistItem[]
  directedMovies Movie[]   @relation("MovieDirector")   
}

// Movie model
model Movie {
  id          Int   @id @default(autoincrement())
  title       String
  overview    String?
  genres      String[] @default([])
  runtime     Int?
  posterUrl   String?
  anotherTitles String[] @default([])
  directorId  Int      
  releaseYear Int
  rating      Float?
  createdAt   DateTime @default(now())

  // Relations
  watchListItems WatchlistItem[]
  director       User     @relation("MovieDirector", fields: [directorId], references: [id], onDelete: Cascade)
}

//watchlistItem model
model WatchlistItem {
  id        Int      @id @default(autoincrement())
  userId    Int
  movieId   Int
  status    WatchlistItemStatus   @default(PLANNED)
  rating    Int?     
  notes     String?
  createdAt DateTime @default(now())

  //relations
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)


  @@unique([userId, movieId])
}

enum WatchlistItemStatus {
  PLANNED
  WATCHING
  COMPLETED
  DROPPED
}